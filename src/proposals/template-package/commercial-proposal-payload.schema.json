{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metodologia.info/schemas/commercial-proposal-payload.schema.json",
  "title": "Commercial Proposal Payload",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": "string",
          "enum": ["es", "en"]
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "view": {
          "type": "string",
          "enum": ["resumen", "detallado", "inmersivo"]
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "runtimeConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "contactEmail": { "type": "string" },
        "reserveSubject": { "type": "string" },
        "workshopSubject": { "type": "string" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "footerContact": { "type": "string" },
            "reserveMailto": { "type": "string" },
            "reserveCalendar": { "type": "string" },
            "reserveNotebook": { "type": "string" },
            "workshopCalendar": { "type": "string" },
            "workshopMailto": { "type": "string" }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootcamp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "current": { "type": ["number", "string"] },
                "regular": { "type": ["number", "string"] },
                "currency": { "type": "string" }
              }
            },
            "assistantUnit": { "type": ["number", "string"] },
            "empowerment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "current": { "type": ["number", "string"] },
                "regular": { "type": ["number", "string"] },
                "currency": { "type": "string" }
              }
            },
            "workshopBonus": { "type": ["number", "string"] },
            "roiPrice": { "type": ["number", "string"] },
            "automationFactor": { "type": ["number", "string"] }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "i18nHtml": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "infoData": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title_es": { "type": "string" },
          "title_en": { "type": "string" },
          "body_es": { "type": "string" },
          "body_en": { "type": "string" }
        }
      }
    },
    "modulesData": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "phase": { "type": "number" },
          "num": { "type": ["number", "string"] },
          "icon": { "type": "string" },
          "title_es": { "type": "string" },
          "title_en": { "type": "string" },
          "method_es": { "type": "string" },
          "method_en": { "type": "string" },
          "work_es": { "type": "string" },
          "work_en": { "type": "string" },
          "deliverable_es": { "type": "string" },
          "deliverable_en": { "type": "string" },
          "assistant_es": { "type": "string" },
          "assistant_en": { "type": "string" }
        }
      }
    },
    "assistantNames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "es": { "type": "string" },
          "en": { "type": "string" }
        }
      }
    },
    "textBySelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "htmlBySelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "attributesBySelector": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean"] }
      }
    }
  }
}
