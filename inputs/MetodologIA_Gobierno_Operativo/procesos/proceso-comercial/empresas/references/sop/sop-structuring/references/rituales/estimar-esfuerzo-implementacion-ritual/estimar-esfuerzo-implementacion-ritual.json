  "glossary": [
    {
      "term": "WBS (Work Breakdown Structure)",
      "definition": "Desglose jerárquico de tareas atómicas para evitar estimaciones vagas."
    },
    {
      "term": "Risk Buffer",
      "definition": "Colchón financiero/temporal aplicado según la incertidumbre técnica."
    },
    {
      "term": "Ruta Crítica",
      "definition": "La secuencia de tareas que determina la duración mínima del proyecto."
    }
  ],
  "steps": [
    {
      "title": "Desglose de Trabajo (WBS)",
      "desc": "Segmentar en bloques de 8h.",
      "output": "Task Breakdown"
    },
    {
      "title": "Estimación por Roles",
      "desc": "Asignar perfiles (Snr vs Jnr).",
      "output": "Resource Plan"
    },
    {
      "title": "Cálculo de Gestión (PM)",
      "desc": "Añadir 15-20% de peso.",
      "output": "Management Overhead"
    },
    {
      "title": "Factor de Contingencia",
      "desc": "Aplicar Buffer de riesgo.",
      "output": "Risk-Adjusted Cost"
    },
    {
      "title": "Costos de Infraestructura",
      "desc": "Licencias y consumos.",
      "output": "Infrastructure CAPEX"
    },
    {
      "title": "Costos de Viáticos (Si aplica)",
      "desc": "Despliegues físicos.",
      "output": "Logistic Table"
    },
    {
      "title": "Revisión de Históricos",
      "desc": "Comparar con proyectos similares.",
      "output": "Benchmark Audit"
    },
    {
      "title": "Análisis de Ruta Crítica",
      "desc": "Detectar cuellos de botella.",
      "output": "Critical Path Map"
    },
    {
      "title": "Verificación de Disponibilidad",
      "desc": "Chequeo de agenda de gente.",
      "output": "Allocation Table"
    },
    {
      "title": "Aprobación de Operaciones",
      "desc": "Firma del COO.",
      "output": "Profitability sign-off"
    }
