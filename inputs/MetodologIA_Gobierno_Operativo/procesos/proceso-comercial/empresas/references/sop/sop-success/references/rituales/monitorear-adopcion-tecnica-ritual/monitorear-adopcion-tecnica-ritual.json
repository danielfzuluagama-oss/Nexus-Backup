    {
      "term": "DAU/MAU Ratio",
      "definition": "Relación entre usuarios activos diarios y mensuales; mide la adherencia."
    },
    {
      "term": "Sticky Features",
      "definition": "Funcionalidades que, una vez usadas, hacen que sea muy difícil dejar la solución."
    }
